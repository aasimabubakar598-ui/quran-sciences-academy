const SUPABASE_URL = "https://kxaovcknyddctnqvrudi.supabase.co";
const SUPABASE_ANON_KEY = "PASTE_YOUR_EXISTING_ANON_KEY_HERE";

const { createClient } = supabase;
const academy = createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

let currentUser = null;
let currentProfile = null;
let currentLanguage = localStorage.getItem("academy-language") || "ar";
let studentData = {
  departments: [],
  courses: [],
  enrollments: [],
  attendance: []
};

const $ = (id) => document.getElementById(id);

function isArabic() {
  return currentLanguage === "ar";
}

function escapeHTML(value) {
  return String(value ?? "").replace(/[&<>"']/g, (char) => ({
    "&": "&amp;",
    "<": "&lt;",
    ">": "&gt;",
    '"': "&quot;",
    "'": "&#039;"
  })[char]);
}

function setMessage(message, isError = false) {
  const element = $("dashboardMessage");
  if (!element) return;

  element.textContent = message || "";
  element.hidden = !message;
  element.style.display = message ? "block" : "none";
  element.style.color = isError ? "#b42318" : "";
}

function setLoading(loading) {
  const button = $("refreshButton");
  if (button) {
    button.disabled = loading;
    button.textContent = loading
      ? (isArabic() ? "جارٍ التحديث..." : "Refreshing...")
      : (isArabic() ? "تحديث البيانات" : "Refresh Data");
  }
}

function updateLanguage() {
  document.documentElement.lang = currentLanguage;
  document.documentElement.dir = isArabic() ? "rtl" : "ltr";
  localStorage.setItem("academy-language", currentLanguage);

  const toggle = $("languageToggle");
  if (toggle) toggle.textContent = isArabic() ? "English" : "العربية";

  if (currentProfile) {
    const heading = $("welcomeTitle");
    if (heading) {
      heading.textContent = isArabic()
        ? `مرحباً، ${currentProfile.full_name || "الطالب"}`
        : `Welcome, ${currentProfile.full_name || "Student"}`;
    }
  }

  renderAll();
}

function showStudentView(view) {
  document.querySelectorAll(".dashboard-section").forEach(section => {
    section.classList.remove("active");
  });

  const target = document.getElementById(`${view}Section`);
  if (target) target.classList.add("active");

  document.querySelectorAll(".nav-item").forEach(button => {
    button.classList.toggle("active", button.dataset.view === view);
  });

  closeMobileSidebar();
}

window.showStudentView = showStudentView;

function openMobileSidebar() {
  const sidebar = $("studentSidebar");
  const overlay = $("studentSidebarOverlay");
  const menuButton = $("mobileMenuButton");

  sidebar?.classList.add("open");
  overlay?.classList.add("visible");
  document.body.classList.add("menu-open");
  menuButton?.setAttribute("aria-expanded", "true");
}

function closeMobileSidebar() {
  const sidebar = $("studentSidebar");
  const overlay = $("studentSidebarOverlay");
  const menuButton = $("mobileMenuButton");

  sidebar?.classList.remove("open");
  overlay?.classList.remove("visible");
  document.body.classList.remove("menu-open");
  menuButton?.setAttribute("aria-expanded", "false");
}

function renderDepartments() {
  const container = $("departmentsList");
  if (!container) return;

  if (!studentData.departments.length) {
    container.innerHTML = `<p>${isArabic() ? "لا توجد أقسام متاحة حالياً." : "No departments available."}</p>`;
    return;
  }

  container.innerHTML = studentData.departments.map(department => `
    <article class="dashboard-card">
      <h3>${escapeHTML(
        isArabic()
          ? department.name_ar || department.name_en || department.name
          : department.name_en || department.name_ar || department.name
      )}</h3>
    </article>
  `).join("");
}

function renderCourses() {
  const container = $("coursesList");
  if (!container) return;

  if (!studentData.courses.length) {
    container.innerHTML = `<p>${isArabic() ? "لا توجد دورات منشورة حالياً." : "No published courses available."}</p>`;
    return;
  }

  container.innerHTML = studentData.courses.map(course => {
    const enrolled = studentData.enrollments.some(
      item => item.course_id === course.id
    );

    const title = isArabic()
      ? course.title_ar || course.title_en || course.title
      : course.title_en || course.title_ar || course.title;

    return `
      <article class="dashboard-card">
        <h3>${escapeHTML(title)}</h3>
        <p>${escapeHTML(course.description || "")}</p>
        <button
          type="button"
          class="enroll-button"
          data-course-id="${escapeHTML(course.id)}"
          ${enrolled ? "disabled" : ""}
        >
          ${enrolled
            ? (isArabic() ? "تم إرسال طلب التسجيل" : "Already requested")
            : (isArabic() ? "طلب التسجيل" : "Request Enrollment")}
        </button>
      </article>
    `;
  }).join("");
}

function renderEnrollments() {
  const container = $("enrollmentsList");
  if (!container) return;

  if (!studentData.enrollments.length) {
    container.innerHTML = `<p>${isArabic() ? "لم ترسل أي طلب تسجيل بعد." : "You have no enrollment requests yet."}</p>`;
    return;
  }

  container.innerHTML = studentData.enrollments.map(enrollment => {
    const course = studentData.courses.find(
      item => item.id === enrollment.course_id
    );

    const title = course
      ? (isArabic()
          ? course.title_ar || course.title_en || course.title
          : course.title_en || course.title_ar || course.title)
      : (isArabic() ? "دورة" : "Course");

    const statusLabels = {
      pending: isArabic() ? "قيد الانتظار" : "Pending",
      approved: isArabic() ? "مقبول" : "Approved",
      rejected: isArabic() ? "مرفوض" : "Rejected"
    };

    return `
      <article class="dashboard-card">
        <h3>${escapeHTML(title)}</h3>
        <p>${escapeHTML(statusLabels[enrollment.status] || enrollment.status || "")}</p>
      </article>
    `;
  }).join("");
}

function renderAttendance() {
  const container = $("attendanceList");
  if (!container) return;

  const records = studentData.attendance;

  if (!records.length) {
    container.innerHTML = `<p>${isArabic() ? "لا توجد سجلات حضور حتى الآن." : "No attendance records yet."}</p>`;
  } else {
    container.innerHTML = records.map(record => {
      const labels = {
        present: isArabic() ? "حاضر" : "Present",
        absent: isArabic() ? "غائب" : "Absent",
        late: isArabic() ? "متأخر" : "Late"
      };

      return `
        <article class="dashboard-card">
          <p><strong>${escapeHTML(record.attendance_date || "")}</strong></p>
          <p>${escapeHTML(labels[record.status] || record.status || "")}</p>
          ${record.remarks ? `<p>${escapeHTML(record.remarks)}</p>` : ""}
        </article>
      `;
    }).join("");
  }

  const summary = $("attendanceSummary");
  if (summary) {
    const present = records.filter(r => r.status === "present").length;
    const absent = records.filter(r => r.status === "absent").length;
    const late = records.filter(r => r.status === "late").length;

    summary.innerHTML = `
      <div class="dashboard-card">
        <strong>${isArabic() ? "حاضر" : "Present"}</strong>
        <p>${present}</p>
      </div>
      <div class="dashboard-card">
        <strong>${isArabic() ? "غائب" : "Absent"}</strong>
        <p>${absent}</p>
      </div>
      <div class="dashboard-card">
        <strong>${isArabic() ? "متأخر" : "Late"}</strong>
        <p>${late}</p>
      </div>
    `;
  }
}

function renderMaterials() {
  const container = $("materialsList");
  if (!container) return;

  container.innerHTML = `
    <p>${isArabic()
      ? "سيتم عرض المواد التعليمية المعتمدة هنا."
      : "Approved learning materials will appear here."}</p>
  `;
}

function renderExams() {
  const container = $("examsList");
  if (!container) return;

  container.innerHTML = `
    <p>${isArabic()
      ? "لا توجد بيانات اختبارات متاحة للعرض حالياً."
      : "Exam information is not available here yet."}</p>
  `;

  const message = $("examsMessage");
  if (message) message.textContent = "";
}

function renderAll() {
  renderDepartments();
  renderCourses();
  renderEnrollments();
  renderAttendance();
  renderMaterials();
  renderExams();

  const year = $("year");
  if (year) year.textContent = new Date().getFullYear();
}

async function loadStudentData() {
  if (!currentUser) return;

  setLoading(true);
  setMessage("");

  try {
    const [
      departmentsResult,
      coursesResult,
      enrollmentsResult,
      attendanceResult
    ] = await Promise.all([
      academy.from("departments").select("*"),
      academy.from("courses").select("*"),
      academy.from("enrollments")
        .select("*")
        .eq("student_id", currentUser.id),
      academy.from("attendance")
        .select("*")
        .eq("student_id", currentUser.id)
        .order("attendance_date", { ascending: false })
    ]);

    const errors = [
      departmentsResult.error,
      coursesResult.error,
      enrollmentsResult.error,
      attendanceResult.error
    ].filter(Boolean);

    if (errors.length) throw errors[0];

    studentData.departments = departmentsResult.data || [];

    const allCourses = coursesResult.data || [];
    studentData.courses = allCourses.filter(course =>
      !("status" in course) || course.status === "published"
    );

    studentData.enrollments = enrollmentsResult.data || [];
    studentData.attendance = attendanceResult.data || [];

    renderAll();
  } catch (error) {
    console.error("Student dashboard loading error:", error);
    setMessage(
      isArabic()
        ? `تعذر تحميل البيانات: ${error.message || "خطأ غير معروف"}`
        : `Could not load your data: ${error.message || "Unknown error"}`,
      true
    );
  } finally {
    setLoading(false);
  }
}

async function requestEnrollment(courseId) {
  if (!currentUser) return;

  const alreadyRequested = studentData.enrollments.some(
    item => item.course_id === courseId
  );

  if (alreadyRequested) return;

  try {
    const { error } = await academy.from("enrollments").insert({
      student_id: currentUser.id,
      course_id: courseId,
      status: "pending"
    });

    if (error) throw error;

    setMessage(
      isArabic()
        ? "تم إرسال طلب التسجيل بنجاح."
        : "Your enrollment request was submitted."
    );

    await loadStudentData();
  } catch (error) {
    console.error("Enrollment request error:", error);
    setMessage(
      isArabic()
        ? `تعذر إرسال الطلب: ${error.message}`
        : `Could not submit request: ${error.message}`,
      true
    );
  }
}

async function logoutStudent() {
  const { error } = await academy.auth.signOut();

  if (error) {
    setMessage(error.message, true);
    return;
  }

  window.location.href = "/login.html";
}

async function initializeStudentPortal() {
  try {
    setMessage(isArabic() ? "جارٍ تحميل بياناتك..." : "Loading your data...");

    const { data: sessionData, error: sessionError } =
      await academy.auth.getSession();

    if (sessionError) throw sessionError;

    const session = sessionData.session;

    if (!session) {
      window.location.href = "/login.html";
      return;
    }

    currentUser = session.user;

    const { data: profile, error: profileError } = await academy
      .from("profiles")
      .select("id, full_name, role")
      .eq("id", currentUser.id)
      .single();

    if (profileError) throw profileError;

    if (profile.role !== "student") {
      await academy.auth.signOut();
      window.location.href = "/login.html";
      return;
    }

    currentProfile = profile;
    updateLanguage();

    await loadStudentData();
    setMessage("");
  } catch (error) {
    console.error("Student portal initialization error:", error);
    setMessage(
      isArabic()
        ? `حدث خطأ أثناء تحميل لوحة الطالب: ${error.message || "خطأ غير معروف"}`
        : `Student dashboard error: ${error.message || "Unknown error"}`,
      true
    );
  }
}

/* Event handlers */
document.addEventListener("click", event => {
  const enrollButton = event.target.closest(".enroll-button");

  if (enrollButton) {
    requestEnrollment(enrollButton.dataset.courseId);
  }
});

$("refreshButton")?.addEventListener("click", loadStudentData);
$("logoutButton")?.addEventListener("click", logoutStudent);

$("languageToggle")?.addEventListener("click", () => {
  currentLanguage = isArabic() ? "en" : "ar";
  updateLanguage();
});

$("mobileMenuButton")?.addEventListener("click", openMobileSidebar);
$("sidebarCloseButton")?.addEventListener("click", closeMobileSidebar);
$("studentSidebarOverlay")?.addEventListener("click", closeMobileSidebar);

document.addEventListener("keydown", event => {
  if (event.key === "Escape") closeMobileSidebar();
});

/* Start */
document.addEventListener("DOMContentLoaded", initializeStudentPortal);
